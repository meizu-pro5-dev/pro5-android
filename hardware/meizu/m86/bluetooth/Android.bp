cc_library_shared {
    name: "android.hardware.bluetooth@1.0-impl.m86",
    defaults: ["hidl_defaults"],
    vendor: true,
    compile_multilib: "32",
    relative_install_path: "hw",
    // The binderized service loads the canonical passthrough implementation
    // name; keep the unique m86 module name for namespace ownership while
    // installing the artifact under the AOSP lookup name.
    stem: "android.hardware.bluetooth@1.0-impl",
    srcs: [
        "bluetooth_address.cc",
        "bluetooth_hci_compat.cc",
        "vendor_interface.cc",
    ],
    include_dirs: ["hardware/interfaces/bluetooth/1.0/default"],
    shared_libs: [
        "android.hardware.bluetooth@1.0",
        "libbase",
        "libcutils",
        "libhardware",
        "libhidlbase",
        "libhidltransport",
        "liblog",
        "libutils",
    ],
    static_libs: [
        "android.hardware.bluetooth-async",
        "android.hardware.bluetooth-hci",
    ],
}

cc_binary {
    name: "android.hardware.bluetooth@1.0-service.m86",
    defaults: ["hidl_defaults"],
    vendor: true,
    compile_multilib: "32",
    relative_install_path: "hw",
    init_rc: ["android.hardware.bluetooth@1.0-service.m86.rc"],
    vintf_fragments: ["android.hardware.bluetooth@1.0-service.m86.xml"],
    srcs: ["service.cpp"],
    shared_libs: [
        "android.hardware.bluetooth@1.0",
        "libbase",
        "libcutils",
        "libdl",
        "libhardware",
        "libhidlbase",
        "libhidltransport",
        "liblog",
        "libutils",
    ],
}
