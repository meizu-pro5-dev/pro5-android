cc_library_shared {
    name: "libm86camera_shim",
    compile_multilib: "32",
    srcs: ["CameraCompat.cpp"],
    shared_libs: [
        "libcutils",
        "liblog",
        "libsensor",
    ],
    ldflags: ["-Wl,--no-as-needed"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
