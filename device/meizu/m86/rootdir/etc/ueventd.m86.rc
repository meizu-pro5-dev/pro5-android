# m86 audio DSP, Smart-PA and mixer nodes. Android 10 hosts the passthrough
# primary HAL in audioserver, whose supplementary audio/media groups replace
# the broader Flyme process credentials.
/dev/i2c-7                   0660   system      audio
/dev/adnc0                   0660   system      audio
/dev/adnc1                   0660   system      audio
/dev/adnc2                   0660   system      audio
/dev/adnc3                   0660   system      audio
/dev/adnc4                   0660   system      audio
/dev/adnc5                   0660   system      audio
/dev/video16                 0660   system      audio

# Exynos display/GPU nodes. These ownerships are common to the verified Flyme
# 8 m86 ramdisk and the Android 10 universal7420 ueventd reference. The Mali
# driver requires per-application access; composition/scaler nodes remain
# limited to the system/media graphics groups.
/dev/mali0                   0666   system      system
/dev/ion                     0666   system      system
/dev/ump                     0666   system      graphics
/dev/exynos-mem              0660   system      graphics
/dev/fimg2d                  0666   system      graphics
/dev/dri/card0               0660   system      graphics
/dev/graphics/fb0            0660   system      graphics
/dev/video20                 0660   system      system
/dev/video23                 0660   media       graphics
/dev/video24                 0660   media       graphics
/dev/video26                 0660   media       graphics
/dev/video27                 0660   media       graphics
/dev/video50                 0660   media       graphics
/dev/video51                 0660   media       graphics

