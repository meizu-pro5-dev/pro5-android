import /init.m86.usb.rc

on early-init
    mount debugfs debugfs /sys/kernel/debug mode=755

on init
    mkdir /custom 0555 root root
    mkdir /efs 0771 radio system
    mkdir /mnv 0555 root root

on fs
    mount_all /fstab.m86

on post-fs-data
    mkdir /data/calibration 0771 wifi wifi
    mkdir /data/gps 0770 gps system
    mkdir /data/nfc 0770 nfc nfc
    mkdir /data/nfc/param 0770 nfc nfc
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    setprop vold.post_fs_data_done 1

on boot
    chown bluetooth bluetooth /dev/ttySAC4
    chmod 0660 /dev/ttySAC4
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/state
    chmod 0660 /sys/class/rfkill/rfkill0/state
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/type
    chown gps system /dev/ttySAC1
    chmod 0660 /dev/ttySAC1
    chown nfc nfc /dev/pn544
    chmod 0660 /dev/pn544
    chown nfc nfc /dev/p61
    chmod 0660 /dev/p61
    chown wifi wifi /sys/module/bcmdhd/parameters/firmware_path
    chmod 0660 /sys/module/bcmdhd/parameters/firmware_path
    chown system system /sys/devices/13930000.decon_fb/adreg
    chmod 0660 /sys/devices/13930000.decon_fb/adreg

service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
    -puse_p2p_group_interface=1 \
    -O/data/vendor/wifi/wpa/sockets \
    -g@android:wpa_wlan0
    interface android.hardware.wifi.supplicant@1.0::ISupplicant default
    interface android.hardware.wifi.supplicant@1.1::ISupplicant default
    interface android.hardware.wifi.supplicant@1.2::ISupplicant default
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot
