cc_library_shared {
    name: "lights.m86",
    relative_install_path: "hw",
    proprietary: true,
    srcs: ["lights.c"],
    header_libs: ["libhardware_headers"],
    shared_libs: ["liblog"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
