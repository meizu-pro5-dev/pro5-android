From 863804bd3b0ba1fc425af068c7377797c44f9285 Mon Sep 17 00:00:00 2001
From: 404698-FDU <228693120+404698-FDU@users.noreply.github.com>
Date: Sat, 29 Aug 2026 06:39:38 +0000
Subject: [PATCH] wifi: handle newer legacy RTT enum values

Change-Id: I417c41edc9b6e80916bd8e0f8982eb452c7a34ad
---
 wifi/1.0-legacy/hidl_struct_util.cpp | 9 +++++++++
 wifi/1.0-legacy/wifi.h               | 4 ++++
 2 files changed, 13 insertions(+)

diff --git a/wifi/1.0-legacy/hidl_struct_util.cpp b/wifi/1.0-legacy/hidl_struct_util.cpp
index ad2fdb2..ff5f989 100644
--- a/wifi/1.0-legacy/hidl_struct_util.cpp
+++ b/wifi/1.0-legacy/hidl_struct_util.cpp
@@ -2295,6 +2295,9 @@ WifiChannelWidthInMhz convertLegacyWifiChannelWidthToHidl(
             return WifiChannelWidthInMhz::WIDTH_10;
         case legacy_hal::WIFI_CHAN_WIDTH_INVALID:
             return WifiChannelWidthInMhz::WIDTH_INVALID;
+        case legacy_hal::WIFI_CHAN_WIDTH_320:
+            CHECK(false) << "320 MHz channel width is not representable by the legacy HIDL";
+            return WifiChannelWidthInMhz::WIDTH_INVALID;
     };
     CHECK(false) << "Unknown legacy type: " << type;
 }
@@ -2323,6 +2326,9 @@ RttPreamble convertLegacyRttPreambleToHidl(legacy_hal::wifi_rtt_preamble type) {
             return RttPreamble::VHT;
         case legacy_hal::WIFI_RTT_PREAMBLE_HE:
             return RttPreamble::HE;
+        case legacy_hal::WIFI_RTT_PREAMBLE_EHT:
+            CHECK(false) << "EHT preamble is not representable by the legacy HIDL";
+            return RttPreamble::HE;
     };
     CHECK(false) << "Unknown legacy type: " << type;
 }
@@ -2359,6 +2365,9 @@ RttBw convertLegacyRttBwToHidl(legacy_hal::wifi_rtt_bw type) {
             return RttBw::BW_80MHZ;
         case legacy_hal::WIFI_RTT_BW_160:
             return RttBw::BW_160MHZ;
+        case legacy_hal::WIFI_RTT_BW_320:
+            CHECK(false) << "320 MHz RTT bandwidth is not representable by the legacy HIDL";
+            return RttBw::BW_160MHZ;
     };
     CHECK(false) << "Unknown legacy type: " << type;
 }
diff --git a/wifi/1.0-legacy/wifi.h b/wifi/1.0-legacy/wifi.h
index 087d6f7..24a4e7d 100644
--- a/wifi/1.0-legacy/wifi.h
+++ b/wifi/1.0-legacy/wifi.h
@@ -20,6 +20,10 @@
 #include <functional>
 
 #include <android-base/macros.h>
+
+// math.h defines NAN as a macro, which collides with the NAN enumerators in
+// the generated Wi-Fi HIDL headers.
+#undef NAN
 #include <android/hardware/wifi/1.4/IWifi.h>
 #include <utils/Looper.h>
 
-- 
2.34.1

