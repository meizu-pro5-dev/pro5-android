From 4a999f2b182bade2b3aafe8b5ad77f6c4afd4382 Mon Sep 17 00:00:00 2001
From: M86 Builder <m86-builder@localhost>
Date: Sat, 29 Aug 2026 11:16:41 +0000
Subject: [PATCH] gpuservice: skip accounting in legacy no-BPF mode

Change-Id: I061599b943dc430b9d23c18e44b5e7a649b6c9ae
---
 services/gpuservice/gpumem/GpuMem.cpp   | 6 ++++++
 services/gpuservice/gpuwork/GpuWork.cpp | 6 ++++++
 2 files changed, 12 insertions(+)

diff --git a/services/gpuservice/gpumem/GpuMem.cpp b/services/gpuservice/gpumem/GpuMem.cpp
index dd3cc3bd86..1fb1f1423b 100644
--- a/services/gpuservice/gpumem/GpuMem.cpp
+++ b/services/gpuservice/gpumem/GpuMem.cpp
@@ -20,6 +20,7 @@
 
 #include "gpumem/GpuMem.h"
 
+#include <android-base/properties.h>
 #include <android-base/stringprintf.h>
 #include <libbpf.h>
 #include <bpf/WaitForProgsLoaded.h>
@@ -40,6 +41,11 @@ GpuMem::~GpuMem() {
 }
 
 void GpuMem::initialize() {
+    if (!android::base::GetBoolProperty("ro.kernel.ebpf.supported", true)) {
+        ALOGW("GPU memory accounting disabled by legacy no-BPF mode");
+        return;
+    }
+
     // Make sure bpf programs are loaded
     bpf::waitForProgsLoaded();
 
diff --git a/services/gpuservice/gpuwork/GpuWork.cpp b/services/gpuservice/gpuwork/GpuWork.cpp
index 974ae38b13..2e48074cf8 100644
--- a/services/gpuservice/gpuwork/GpuWork.cpp
+++ b/services/gpuservice/gpuwork/GpuWork.cpp
@@ -20,6 +20,7 @@
 
 #include "gpuwork/GpuWork.h"
 
+#include <android-base/properties.h>
 #include <android-base/stringprintf.h>
 #include <binder/PermissionCache.h>
 #include <bpf/WaitForProgsLoaded.h>
@@ -118,6 +119,11 @@ GpuWork::~GpuWork() {
 }
 
 void GpuWork::initialize() {
+    if (!android::base::GetBoolProperty("ro.kernel.ebpf.supported", true)) {
+        ALOGW("GPU work accounting disabled by legacy no-BPF mode");
+        return;
+    }
+
     // Make sure BPF programs are loaded.
     bpf::waitForProgsLoaded();
 
