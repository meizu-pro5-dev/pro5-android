From 71a900b9d7472871a53139d162dfdca104e250a9 Mon Sep 17 00:00:00 2001
From: 404698-FDU <228693120+404698-FDU@users.noreply.github.com>
Date: Sat, 29 Aug 2026 06:00:08 +0000
Subject: [PATCH] Connectivity: tolerate missing BPF maps on legacy kernels

Change-Id: I2789f6d96e9dc163fdd1d79e06f80e5ad1912e20
---
 .../libs/libnetworkstats/BpfNetworkStats.cpp  | 27 +++++----
 .../server/net/NetworkStatsFactory.java       |  8 ++-
 .../server/net/NetworkStatsService.java       | 58 +++++++++++--------
 3 files changed, 55 insertions(+), 38 deletions(-)

diff --git a/service-t/native/libs/libnetworkstats/BpfNetworkStats.cpp b/service-t/native/libs/libnetworkstats/BpfNetworkStats.cpp
index 9ebef4d6d2..097bfca32e 100644
--- a/service-t/native/libs/libnetworkstats/BpfNetworkStats.cpp
+++ b/service-t/native/libs/libnetworkstats/BpfNetworkStats.cpp
@@ -100,18 +100,23 @@ int bpfGetIfaceStatsInternal(const char* iface, Stats* stats,
 }
 
 int bpfGetIfaceStats(const char* iface, Stats* stats) {
-    BpfMapRO<uint32_t, StatsValue> ifaceStatsMap(IFACE_STATS_MAP_PATH);
-    int ret;
-    if (!ifaceStatsMap.isValid()) {
-        ret = -errno;
-        ALOGE("get ifaceStats map fd failed: %s", strerror(errno));
-        return ret;
+    // Legacy kernels may deliberately run without eBPF. Use the fallible map
+    // initializer instead of the pathname constructor, which aborts when the
+    // pinned map is absent. Legacy-kernel mode selects xt_qtaguid in the
+    // NetworkStats factory, while direct TrafficStats calls fail gracefully.
+    BpfMapRO<uint32_t, StatsValue> ifaceStatsMap;
+    const auto ifaceStatsResult = ifaceStatsMap.init(IFACE_STATS_MAP_PATH);
+    if (!ifaceStatsResult.ok()) {
+        const int error = ifaceStatsResult.error().code();
+        ALOGE("get ifaceStats map fd failed: %s", strerror(error));
+        return -error;
     }
-    BpfMapRO<uint32_t, IfaceValue> ifaceIndexNameMap(IFACE_INDEX_NAME_MAP_PATH);
-    if (!ifaceIndexNameMap.isValid()) {
-        ret = -errno;
-        ALOGE("get ifaceIndexName map fd failed: %s", strerror(errno));
-        return ret;
+    BpfMapRO<uint32_t, IfaceValue> ifaceIndexNameMap;
+    const auto ifaceNameResult = ifaceIndexNameMap.init(IFACE_INDEX_NAME_MAP_PATH);
+    if (!ifaceNameResult.ok()) {
+        const int error = ifaceNameResult.error().code();
+        ALOGE("get ifaceIndexName map fd failed: %s", strerror(error));
+        return -error;
     }
     return bpfGetIfaceStatsInternal(iface, stats, ifaceStatsMap, ifaceIndexNameMap);
 }
diff --git a/service-t/src/com/android/server/net/NetworkStatsFactory.java b/service-t/src/com/android/server/net/NetworkStatsFactory.java
