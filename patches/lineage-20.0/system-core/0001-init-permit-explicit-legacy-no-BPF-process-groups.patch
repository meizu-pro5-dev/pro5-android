From 3e31e9ebaa3e60ccd20b7d2a5c733e742850495f Mon Sep 17 00:00:00 2001
From: 404698-FDU <228693120+404698-FDU@users.noreply.github.com>
Date: Sat, 29 Aug 2026 06:00:08 +0000
Subject: [PATCH] init: permit explicit legacy no-BPF process groups

Change-Id: Id6d407125ed5199c6c3a26ee918ea8ead96a53be
---
 init/service.cpp | 22 ++++++++++++++++------
 1 file changed, 16 insertions(+), 6 deletions(-)

diff --git a/init/service.cpp b/init/service.cpp
index 7e43061c4c..1dc7118653 100644
--- a/init/service.cpp
+++ b/init/service.cpp
@@ -664,13 +664,23 @@ Result<void> Service::Start() {
 
     bool use_memcg = swappiness_ != -1 || soft_limit_in_bytes_ != -1 || limit_in_bytes_ != -1 ||
                       limit_percent_ != -1 || !limit_property_.empty();
-    errno = -createProcessGroup(proc_attr_.uid, pid_, use_memcg);
-    if (errno != 0) {
-        if (char byte = 0; write((*pipefd)[1], &byte, 1) < 0) {
-            return ErrnoError() << "sending notification failed";
+    const int process_group_errno = -createProcessGroup(proc_attr_.uid, pid_, use_memcg);
+    if (process_group_errno != 0) {
+        errno = process_group_errno;
+        if (GetBoolProperty("ro.kernel.ebpf.supported", true)) {
+            if (char byte = 0; write((*pipefd)[1], &byte, 1) < 0) {
+                return ErrnoError() << "sending notification failed";
+            }
+            return Error() << "createProcessGroup(" << proc_attr_.uid << ", " << pid_
+                           << ") failed for service '" << name_ << "'";
         }
-        return Error() << "createProcessGroup(" << proc_attr_.uid << ", " << pid_
-                       << ") failed for service '" << name_ << "'";
+
+        // Explicit legacy-kernel bring-up mode: Android 13's process-group
+        // layout can include controllers unavailable on the 3.10 kernel. The
+        // child is still usable, so keep booting but retain a loud diagnostic.
+        errno = process_group_errno;
+        PLOG(WARNING) << "Ignoring createProcessGroup(" << proc_attr_.uid << ", " << pid_
+                      << ") failure for no-BPF service '" << name_ << "'";
     }
 
     if (use_memcg) {
-- 
2.34.1

