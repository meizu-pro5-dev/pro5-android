From 192589acc7cbc112d1bf332b5a310e67171a82fa Mon Sep 17 00:00:00 2001
From: 404698-FDU <228693120+404698-FDU@users.noreply.github.com>
Date: Sat, 5 Sep 2026 16:01:28 +0000
Subject: [PATCH] updater: honor explicit source fingerprints in host
 simulation

Change-Id: I7534dc1ed0cb67fa93cc0efd250776a0a2237b3e
---
 updater/build_info.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/updater/build_info.cpp b/updater/build_info.cpp
index f168008e..b022a4fa 100644
--- a/updater/build_info.cpp
+++ b/updater/build_info.cpp
@@ -106,6 +106,11 @@ std::string BuildInfo::GetProperty(const std::string_view key,
     LOG(WARNING) << "Failed to find property: " << key;
     return std::string(default_value);
   } else if (key == "ro.build.fingerprint") {
+    // init derives the fingerprint only when no explicit value was supplied.
+    if (auto entry = build_props_.find(key);
+        entry != build_props_.end() && !entry->second.empty()) {
+      return entry->second;
+    }
     // clang-format off
     return android::base::StringPrintf("%s/%s/%s:%s/%s/%s:%s/%s",
         GetProperty("ro.product.brand", "").c_str(),
