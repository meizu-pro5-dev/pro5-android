 int MtpDevHandle::start(bool /* ptp */) {
+	// The legacy character-device path was already opened by MtpServer.  Its
+	// kernel driver is exclusive-open, so opening it again returns EBUSY.
+	if (mFd != -1) return 0;
+
 	mFd.reset(TEMP_FAILURE_RETRY(open(mtp_dev_path, O_RDWR)));
 	if (mFd == -1) return -1;
 	return 0;
