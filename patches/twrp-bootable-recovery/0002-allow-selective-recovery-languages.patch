diff --git a/gui/Android.mk b/gui/Android.mk
--- a/gui/Android.mk
+++ b/gui/Android.mk
@@ -152,7 +152,29 @@ endef
 
 TWRP_RES := $(LOCAL_PATH)/theme/common/fonts
 TWRP_RES += $(LOCAL_PATH)/theme/common/languages
-ifeq ($(TW_EXTRA_LANGUAGES),true)
+ifneq ($(strip $(TW_LANGUAGE_ALLOWLIST)),)
+    TWRP_LANGUAGE_FILES := \
+        $(wildcard $(LOCAL_PATH)/theme/common/languages/*.xml) \
+        $(wildcard $(LOCAL_PATH)/theme/extra-languages/languages/*.xml)
+    TWRP_SELECTED_LANGUAGE_FILES := $(foreach language, \
+        $(TW_LANGUAGE_ALLOWLIST), \
+        $(filter %/$(language).xml,$(TWRP_LANGUAGE_FILES)))
+    TWRP_SELECTED_LANGUAGE_NAMES := \
+        $(basename $(notdir $(TWRP_SELECTED_LANGUAGE_FILES)))
+    ifneq ($(sort $(TW_LANGUAGE_ALLOWLIST)),$(sort $(TWRP_SELECTED_LANGUAGE_NAMES)))
+        $(error TW_LANGUAGE_ALLOWLIST names an unavailable language: \
+            $(filter-out $(TWRP_SELECTED_LANGUAGE_NAMES), \
+            $(TW_LANGUAGE_ALLOWLIST)))
+    endif
+    ifneq ($(filter zh_CN zh_TW,$(TW_LANGUAGE_ALLOWLIST)),)
+        TWRP_SELECTED_LANGUAGE_FONTS += \
+            $(LOCAL_PATH)/theme/extra-languages/fonts/DroidSansFallback.ttf
+    endif
+    ifneq ($(filter ja,$(TW_LANGUAGE_ALLOWLIST)),)
+        TWRP_SELECTED_LANGUAGE_FONTS += \
+            $(LOCAL_PATH)/theme/extra-languages/fonts/NotoSansCJKjp-Regular.ttf
+    endif
+else ifeq ($(TW_EXTRA_LANGUAGES),true)
     TWRP_RES += $(LOCAL_PATH)/theme/extra-languages/fonts
     TWRP_RES += $(LOCAL_PATH)/theme/extra-languages/languages
 endif
@@ -206,6 +228,15 @@ $(TWRP_RES_GEN):
 	mkdir -p $(TARGET_RECOVERY_ROOT_OUT)$(TWRES_PATH)
 	cp -fr $(TWRP_RES) $(TARGET_RECOVERY_ROOT_OUT)$(TWRES_PATH)
 	cp -fr $(TWRP_THEME_LOC)/* $(TARGET_RECOVERY_ROOT_OUT)$(TWRES_PATH)
+ifneq ($(strip $(TW_LANGUAGE_ALLOWLIST)),)
+	rm -f $(TARGET_RECOVERY_ROOT_OUT)$(TWRES_PATH)/languages/*.xml
+	cp -f $(TWRP_SELECTED_LANGUAGE_FILES) \
+		$(TARGET_RECOVERY_ROOT_OUT)$(TWRES_PATH)/languages/
+ifneq ($(strip $(TWRP_SELECTED_LANGUAGE_FONTS)),)
+	cp -f $(TWRP_SELECTED_LANGUAGE_FONTS) \
+		$(TARGET_RECOVERY_ROOT_OUT)$(TWRES_PATH)/fonts/
+endif
+endif
 
 LOCAL_GENERATED_SOURCES := $(TWRP_RES_GEN)
 LOCAL_SRC_FILES := twrp $(TWRP_RES_GEN)
