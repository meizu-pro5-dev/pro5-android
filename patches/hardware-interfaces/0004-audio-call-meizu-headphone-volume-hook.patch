From a7fe184a557681f5cb11a11dccf6d04c00416004 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Sun, 9 Aug 2026 13:24:00 +0800
Subject: [PATCH] audio: call Meizu headphone volume hook

The m86 proprietary HAL extends audio_hw_device with a
set_headphone_volume callback. Consume AudioFlinger's private compatibility
parameter at the legacy-to-HIDL boundary and call that callback directly.

Keeping the dispatch here is necessary because AudioFlinger sees the HIDL
DeviceHalInterface rather than the underlying audio_hw_device structure.
---
 audio/core/all-versions/default/Device.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/audio/core/all-versions/default/Device.cpp b/audio/core/all-versions/default/Device.cpp
index 2cfee6aff..f4f72955c 100644
--- a/audio/core/all-versions/default/Device.cpp
+++ b/audio/core/all-versions/default/Device.cpp
@@ -24,5 +24,6 @@
 //#define LOG_NDEBUG 0
 
+#include <errno.h>
 #include <memory.h>
 #include <string.h>
 #include <algorithm>
@@ -52,6 +53,14 @@ char* Device::halGetParameters(const char* keys) {
 }
 
 int Device::halSetParameters(const char* keysAndValues) {
+    if (strcmp(keysAndValues, "vendor.meizu.set_headphone_volume=1") == 0) {
+        if (mDevice->set_headphone_volume == nullptr) {
+            ALOGW("Meizu headphone volume callback is unavailable");
+            return -ENOSYS;
+        }
+        return mDevice->set_headphone_volume(mDevice, 1.0f);
+    }
+
     return mDevice->set_parameters(mDevice, keysAndValues);
 }
 
