From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PRO 5 Android 10 Port <pro5-port@localhost>
Date: Fri, 7 Aug 2026 04:05:00 +0800
Subject: [PATCH] universal7420: use the platform radio daemon for m86

The common tree carries a Samsung-specific pre-HIDL rild executable with the
same module name as Android 10's platform daemon.  PRO 5 uses the platform
daemon as its HIDL-facing compatibility layer and loads the verified Flyme
RIL v12 implementation through rild.libpath, so do not register the obsolete
Samsung module for this target.

Keep the legacy source available for the Galaxy products and for ABI research.
---
 hardware/rild/Android.mk | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/hardware/rild/Android.mk b/hardware/rild/Android.mk
--- a/hardware/rild/Android.mk
+++ b/hardware/rild/Android.mk
@@ -1,5 +1,7 @@
 # Copyright 2006 The Android Open Source Project
 
+ifneq ($(TARGET_DEVICE_IS_M86),true)
+
 LOCAL_PATH:= $(call my-dir)
 include $(CLEAR_VARS)
 
@@ -30,3 +32,5 @@ LOCAL_MODULE := rild
 
 include $(BUILD_EXECUTABLE)
 
+endif
+
-- 
2.34.1
