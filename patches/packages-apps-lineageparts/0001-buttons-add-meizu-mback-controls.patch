From 5146ba480ec550f7863ce299756e723e7da7ecb4 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Sun, 9 Aug 2026 15:54:49 +0800
Subject: [PATCH] buttons: add Meizu mBack controls

---
 res/values-zh-rCN/strings.xml                 |  7 +++
 res/values/arrays.xml                         | 31 ++++++++++++
 res/values/strings.xml                        |  7 +++
 res/xml/button_settings.xml                   | 38 +++++++++++++++
 .../lineageparts/input/ButtonSettings.java    | 48 +++++++++++++++++++
 5 files changed, 131 insertions(+)

diff --git a/res/values-zh-rCN/strings.xml b/res/values-zh-rCN/strings.xml
index c117a1d..db8f4aa 100644
--- a/res/values-zh-rCN/strings.xml
+++ b/res/values-zh-rCN/strings.xml
@@ -144,6 +144,13 @@
     <string name="hardware_keys_short_press_title">短按行为</string>
     <string name="hardware_keys_long_press_title">长按行为</string>
     <string name="hardware_keys_double_tap_title">双击行为</string>
+    <string name="mback_category_title">mBack</string>
+    <string name="mback_tap_title">轻触操作</string>
+    <string name="mback_double_tap_title">双击操作</string>
+    <string name="mback_swipe_left_title">向左滑动操作</string>
+    <string name="mback_swipe_right_title">向右滑动操作</string>
+    <string name="mback_action_home">主屏幕</string>
+    <string name="mback_action_back">返回</string>
     <string name="hardware_keys_action_nothing">无动作</string>
     <string name="hardware_keys_action_menu">开启/关闭菜单</string>
     <string name="hardware_keys_action_app_switch">最近使用应用切换器</string>
diff --git a/res/values/arrays.xml b/res/values/arrays.xml
index 7e8e45d..c33feed 100644
--- a/res/values/arrays.xml
+++ b/res/values/arrays.xml
@@ -123,6 +123,37 @@
         <item>11</item>
     </string-array>
 
+    <!-- Meizu mBack can also reproduce the two basic navigation keys. -->
+    <string-array name="mback_action_entries" translatable="false">
+        <item>@string/hardware_keys_action_nothing</item>
+        <item>@string/hardware_keys_action_menu</item>
+        <item>@string/hardware_keys_action_app_switch</item>
+        <item>@string/hardware_keys_action_search</item>
+        <item>@string/hardware_keys_action_voice_search</item>
+        <item>@string/hardware_keys_action_in_app_search</item>
+        <item>@string/hardware_keys_action_launch_camera</item>
+        <item>@string/hardware_keys_action_sleep</item>
+        <item>@string/hardware_keys_action_last_app</item>
+        <item>@string/hardware_keys_action_split_screen</item>
+        <item>@string/mback_action_home</item>
+        <item>@string/mback_action_back</item>
+    </string-array>
+
+    <string-array name="mback_action_values" translatable="false">
+        <item>0</item>
+        <item>1</item>
+        <item>2</item>
+        <item>3</item>
+        <item>4</item>
+        <item>5</item>
+        <item>6</item>
+        <item>7</item>
+        <item>8</item>
+        <item>9</item>
+        <item>12</item>
+        <item>13</item>
+    </string-array>
+
     <!-- Volume key cursor control -->
     <string-array name="volbtn_cursor_control_entries" translatable="false">
         <item>@string/volbtn_cursor_control_off</item>
diff --git a/res/values/strings.xml b/res/values/strings.xml
index f99f127..fe44307 100644
--- a/res/values/strings.xml
+++ b/res/values/strings.xml
@@ -178,6 +178,13 @@
     <string name="hardware_keys_short_press_title">Short press action</string>
     <string name="hardware_keys_long_press_title">Long press action</string>
     <string name="hardware_keys_double_tap_title">Double tap action</string>
+    <string name="mback_category_title">mBack</string>
+    <string name="mback_tap_title">Tap action</string>
+    <string name="mback_double_tap_title">Double tap action</string>
+    <string name="mback_swipe_left_title">Swipe left action</string>
+    <string name="mback_swipe_right_title">Swipe right action</string>
+    <string name="mback_action_home">Home</string>
+    <string name="mback_action_back">Back</string>
     <string name="hardware_keys_action_nothing">No action</string>
     <string name="hardware_keys_action_menu">Open/close menu</string>
     <string name="hardware_keys_action_app_switch">Recent apps switcher</string>
diff --git a/res/xml/button_settings.xml b/res/xml/button_settings.xml
index c57985c..d6d29ea 100644
--- a/res/xml/button_settings.xml
+++ b/res/xml/button_settings.xml
@@ -81,6 +81,44 @@
 
     </PreferenceCategory>
 
+    <PreferenceCategory
+        android:key="mback_category"
+        android:title="@string/mback_category_title">
+
+        <ListPreference
+            android:key="mback_tap_action"
+            android:dialogTitle="@string/mback_tap_title"
+            android:title="@string/mback_tap_title"
+            android:entries="@array/mback_action_entries"
+            android:entryValues="@array/mback_action_values"
+            android:persistent="false" />
+
+        <ListPreference
+            android:key="mback_double_tap_action"
+            android:dialogTitle="@string/mback_double_tap_title"
+            android:title="@string/mback_double_tap_title"
+            android:entries="@array/mback_action_entries"
+            android:entryValues="@array/mback_action_values"
+            android:persistent="false" />
+
+        <ListPreference
+            android:key="mback_swipe_left_action"
+            android:dialogTitle="@string/mback_swipe_left_title"
+            android:title="@string/mback_swipe_left_title"
+            android:entries="@array/mback_action_entries"
+            android:entryValues="@array/mback_action_values"
+            android:persistent="false" />
+
+        <ListPreference
+            android:key="mback_swipe_right_action"
+            android:dialogTitle="@string/mback_swipe_right_title"
+            android:title="@string/mback_swipe_right_title"
+            android:entries="@array/mback_action_entries"
+            android:entryValues="@array/mback_action_values"
+            android:persistent="false" />
+
+    </PreferenceCategory>
+
     <PreferenceCategory
         android:key="power_key"
         android:title="@string/hardware_keys_power_key_title" >
diff --git a/src/org/lineageos/lineageparts/input/ButtonSettings.java b/src/org/lineageos/lineageparts/input/ButtonSettings.java
index 423dc60..d75e8b6 100644
--- a/src/org/lineageos/lineageparts/input/ButtonSettings.java
+++ b/src/org/lineageos/lineageparts/input/ButtonSettings.java
@@ -28,6 +28,7 @@ import android.content.res.Resources;
 import android.os.Bundle;
 import android.os.Handler;
 import android.os.RemoteException;
+import android.os.SystemProperties;
 import android.os.UserHandle;
 import android.provider.Settings;
 import android.util.ArraySet;
@@ -94,6 +95,10 @@ public class ButtonSettings extends SettingsPreferenceFragment
     private static final String KEY_EDGE_LONG_SWIPE = "navigation_bar_edge_long_swipe";
     private static final String KEY_POWER_END_CALL = "power_end_call";
     private static final String KEY_HOME_ANSWER_CALL = "home_answer_call";
+    private static final String KEY_MBACK_TAP = "mback_tap_action";
+    private static final String KEY_MBACK_DOUBLE_TAP = "mback_double_tap_action";
+    private static final String KEY_MBACK_SWIPE_LEFT = "mback_swipe_left_action";
+    private static final String KEY_MBACK_SWIPE_RIGHT = "mback_swipe_right_action";
     private static final String KEY_VOLUME_MUSIC_CONTROLS = "volbtn_music_controls";
     private static final String KEY_TORCH_LONG_PRESS_POWER_GESTURE =
             "torch_long_press_power_gesture";
@@ -112,6 +117,7 @@ public class ButtonSettings extends SettingsPreferenceFragment
     private static final String CATEGORY_VOLUME = "volume_keys";
     private static final String CATEGORY_BACKLIGHT = "key_backlight";
     private static final String CATEGORY_NAVBAR = "navigation_bar_category";
+    private static final String CATEGORY_MBACK = "mback_category";
     private static final String CATEGORY_EXTRAS = "extras_category";
 
     private ListPreference mHomeLongPressAction;
@@ -136,6 +142,10 @@ public class ButtonSettings extends SettingsPreferenceFragment
     private ListPreference mNavigationHomeDoubleTapAction;
     private ListPreference mNavigationAppSwitchLongPressAction;
     private ListPreference mEdgeLongSwipeAction;
+    private ListPreference mMbackTapAction;
+    private ListPreference mMbackDoubleTapAction;
+    private ListPreference mMbackSwipeLeftAction;
+    private ListPreference mMbackSwipeRightAction;
     private SwitchPreference mPowerEndCall;
     private SwitchPreference mHomeAnswerCall;
     private SwitchPreference mTorchLongPressPowerGesture;
@@ -181,8 +191,22 @@ public class ButtonSettings extends SettingsPreferenceFragment
         final PreferenceCategory appSwitchCategory = prefScreen.findPreference(CATEGORY_APPSWITCH);
         final PreferenceCategory volumeCategory = prefScreen.findPreference(CATEGORY_VOLUME);
         final PreferenceCategory cameraCategory = prefScreen.findPreference(CATEGORY_CAMERA);
+        final PreferenceCategory mbackCategory = prefScreen.findPreference(CATEGORY_MBACK);
         final PreferenceCategory extrasCategory = prefScreen.findPreference(CATEGORY_EXTRAS);
 
+        if (SystemProperties.getBoolean("ro.meizu.hardware.mback", false)) {
+            mMbackTapAction = initList(KEY_MBACK_TAP, Action.fromSettings(resolver,
+                    LineageSettings.System.MBACK_TAP_ACTION, Action.BACK));
+            mMbackDoubleTapAction = initList(KEY_MBACK_DOUBLE_TAP, Action.fromSettings(resolver,
+                    LineageSettings.System.MBACK_DOUBLE_TAP_ACTION, Action.NOTHING));
+            mMbackSwipeLeftAction = initList(KEY_MBACK_SWIPE_LEFT, Action.fromSettings(resolver,
+                    LineageSettings.System.MBACK_SWIPE_LEFT_ACTION, Action.HOME));
+            mMbackSwipeRightAction = initList(KEY_MBACK_SWIPE_RIGHT, Action.fromSettings(resolver,
+                    LineageSettings.System.MBACK_SWIPE_RIGHT_ACTION, Action.APP_SWITCH));
+        } else {
+            prefScreen.removePreference(mbackCategory);
+        }
+
         // Power button ends calls.
         mPowerEndCall = findPreference(KEY_POWER_END_CALL);
 
@@ -577,6 +601,22 @@ public class ButtonSettings extends SettingsPreferenceFragment
             handleListChange(mEdgeLongSwipeAction, newValue,
                     LineageSettings.System.KEY_EDGE_LONG_SWIPE_ACTION);
             return true;
+        } else if (preference == mMbackTapAction) {
+            handleListChange(mMbackTapAction, newValue,
+                    LineageSettings.System.MBACK_TAP_ACTION);
+            return true;
+        } else if (preference == mMbackDoubleTapAction) {
+            handleListChange(mMbackDoubleTapAction, newValue,
+                    LineageSettings.System.MBACK_DOUBLE_TAP_ACTION);
+            return true;
+        } else if (preference == mMbackSwipeLeftAction) {
+            handleListChange(mMbackSwipeLeftAction, newValue,
+                    LineageSettings.System.MBACK_SWIPE_LEFT_ACTION);
+            return true;
+        } else if (preference == mMbackSwipeRightAction) {
+            handleListChange(mMbackSwipeRightAction, newValue,
+                    LineageSettings.System.MBACK_SWIPE_RIGHT_ACTION);
+            return true;
         }
         return false;
     }
@@ -772,6 +812,14 @@ public class ButtonSettings extends SettingsPreferenceFragment
                 result.add(KEY_VOLUME_ANSWER_CALL);
             }
 
+            if (!SystemProperties.getBoolean("ro.meizu.hardware.mback", false)) {
+                result.add(CATEGORY_MBACK);
+                result.add(KEY_MBACK_TAP);
+                result.add(KEY_MBACK_DOUBLE_TAP);
+                result.add(KEY_MBACK_SWIPE_LEFT);
+                result.add(KEY_MBACK_SWIPE_RIGHT);
+            }
+
             if (!DeviceUtils.hasBackKey(context)) {
                 result.add(CATEGORY_BACK);
                 result.add(KEY_BACK_WAKE_SCREEN);
-- 
