From b96a45212926c11ec243e82afb99c7947e521e3f Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Sun, 9 Aug 2026 15:54:49 +0800
Subject: [PATCH] input: add Meizu mBack actions and settings

---
 api/lineage_current.txt                       |  5 ++-
 .../lineageos/providers/LineageSettings.java  | 36 +++++++++++++++++++
 .../internal/util/DeviceKeysConstants.java    |  5 +--
 3 files changed, 43 insertions(+), 3 deletions(-)

diff --git a/api/lineage_current.txt b/api/lineage_current.txt
index 13e70b3..a3284b8 100644
--- a/api/lineage_current.txt
+++ b/api/lineage_current.txt
@@ -839,6 +839,10 @@ package lineageos.providers {
     field public static final java.lang.String LOCKSCREEN_PIN_SCRAMBLE_LAYOUT = "lockscreen_scramble_pin_layout";
     field public static final java.lang.String LOCKSCREEN_ROTATION = "lockscreen_rotation";
     field public static final java.lang.String LONG_SCREEN_APPS = "long_screen_apps";
+    field public static final java.lang.String MBACK_DOUBLE_TAP_ACTION = "mback_double_tap_action";
+    field public static final java.lang.String MBACK_SWIPE_LEFT_ACTION = "mback_swipe_left_action";
+    field public static final java.lang.String MBACK_SWIPE_RIGHT_ACTION = "mback_swipe_right_action";
+    field public static final java.lang.String MBACK_TAP_ACTION = "mback_tap_action";
     field public static final java.lang.String MENU_WAKE_SCREEN = "menu_wake_screen";
     field public static final java.lang.String NAVBAR_LEFT_IN_LANDSCAPE = "navigation_bar_left";
     field public static final java.lang.String NAVIGATION_BAR_MENU_ARROW_KEYS = "navigation_bar_menu_arrow_keys";
@@ -1175,4 +1179,3 @@ package lineageos.weatherservice {
   }
 
 }
-
diff --git a/sdk/src/java/lineageos/providers/LineageSettings.java b/sdk/src/java/lineageos/providers/LineageSettings.java
index 359eddb..70533b5 100644
--- a/sdk/src/java/lineageos/providers/LineageSettings.java
+++ b/sdk/src/java/lineageos/providers/LineageSettings.java
@@ -1075,6 +1075,38 @@ public final class LineageSettings {
         public static final Validator KEY_HOME_DOUBLE_TAP_ACTION_VALIDATOR =
                 new InclusiveIntegerRangeValidator(0, 9);
 
+        /**
+         * Action to perform when the Meizu mBack sensor is tapped.
+         * Uses DeviceKeysConstants.Action values, including 12 for Home and
+         * 13 for Back.
+         */
+        public static final String MBACK_TAP_ACTION = "mback_tap_action";
+
+        /** @hide */
+        public static final Validator MBACK_TAP_ACTION_VALIDATOR =
+                new InclusiveIntegerRangeValidator(0, 13);
+
+        /** Action to perform when the Meizu mBack sensor is double-tapped. */
+        public static final String MBACK_DOUBLE_TAP_ACTION = "mback_double_tap_action";
+
+        /** @hide */
+        public static final Validator MBACK_DOUBLE_TAP_ACTION_VALIDATOR =
+                new InclusiveIntegerRangeValidator(0, 13);
+
+        /** Action to perform when the Meizu mBack sensor is swiped left. */
+        public static final String MBACK_SWIPE_LEFT_ACTION = "mback_swipe_left_action";
+
+        /** @hide */
+        public static final Validator MBACK_SWIPE_LEFT_ACTION_VALIDATOR =
+                new InclusiveIntegerRangeValidator(0, 13);
+
+        /** Action to perform when the Meizu mBack sensor is swiped right. */
+        public static final String MBACK_SWIPE_RIGHT_ACTION = "mback_swipe_right_action";
+
+        /** @hide */
+        public static final Validator MBACK_SWIPE_RIGHT_ACTION_VALIDATOR =
+                new InclusiveIntegerRangeValidator(0, 13);
+
         /**
          * Whether to wake the screen with the back key, the value is boolean.
          * 0 = 0ff, 1 = on
@@ -2256,6 +2288,10 @@ public final class LineageSettings {
             VALIDATORS.put(NAVIGATION_BAR_HINT, NAVIGATION_BAR_HINT_VALIDATOR);
             VALIDATORS.put(KEY_HOME_LONG_PRESS_ACTION, KEY_HOME_LONG_PRESS_ACTION_VALIDATOR);
             VALIDATORS.put(KEY_HOME_DOUBLE_TAP_ACTION, KEY_HOME_DOUBLE_TAP_ACTION_VALIDATOR);
+            VALIDATORS.put(MBACK_TAP_ACTION, MBACK_TAP_ACTION_VALIDATOR);
+            VALIDATORS.put(MBACK_DOUBLE_TAP_ACTION, MBACK_DOUBLE_TAP_ACTION_VALIDATOR);
+            VALIDATORS.put(MBACK_SWIPE_LEFT_ACTION, MBACK_SWIPE_LEFT_ACTION_VALIDATOR);
+            VALIDATORS.put(MBACK_SWIPE_RIGHT_ACTION, MBACK_SWIPE_RIGHT_ACTION_VALIDATOR);
             VALIDATORS.put(BACK_WAKE_SCREEN, BACK_WAKE_SCREEN_VALIDATOR);
             VALIDATORS.put(MENU_WAKE_SCREEN, MENU_WAKE_SCREENN_VALIDATOR);
             VALIDATORS.put(VOLUME_ANSWER_CALL, VOLUME_ANSWER_CALL_VALIDATOR);
diff --git a/sdk/src/java/org/lineageos/internal/util/DeviceKeysConstants.java b/sdk/src/java/org/lineageos/internal/util/DeviceKeysConstants.java
index 17d7e70..e9a9adc 100644
--- a/sdk/src/java/org/lineageos/internal/util/DeviceKeysConstants.java
+++ b/sdk/src/java/org/lineageos/internal/util/DeviceKeysConstants.java
@@ -37,7 +37,9 @@ public class DeviceKeysConstants {
         LAST_APP,
         SPLIT_SCREEN,
         SINGLE_HAND_LEFT,
-        SINGLE_HAND_RIGHT;
+        SINGLE_HAND_RIGHT,
+        HOME,
+        BACK;
 
         public static Action fromIntSafe(int id) {
             if (id < NOTHING.ordinal() || id > Action.values().length) {
@@ -63,4 +65,3 @@ public class DeviceKeysConstants {
     public static final int KEY_MASK_CAMERA = 0x20;
     public static final int KEY_MASK_VOLUME = 0x40;
 }
-
