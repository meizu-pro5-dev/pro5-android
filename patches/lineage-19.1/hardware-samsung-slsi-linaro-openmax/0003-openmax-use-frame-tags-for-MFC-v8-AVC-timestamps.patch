From 356a7a3d6057d32f6dcfe529f83a25170c3eec26 Mon Sep 17 00:00:00 2001
From: M86 Builder <m86-builder@localhost>
Date: Thu, 27 Aug 2026 01:10:33 +0000
Subject: [PATCH 3/4] openmax: use frame tags for MFC v8 AVC timestamps

---
 .../video/enc/h264/Exynos_OMX_H264enc.c       | 23 ++++++++++++++++---
 1 file changed, 20 insertions(+), 3 deletions(-)

diff --git a/openmax/component/video/enc/h264/Exynos_OMX_H264enc.c b/openmax/component/video/enc/h264/Exynos_OMX_H264enc.c
index bc0baf443fc7574ec32225fa0f02c6a5eaf2fb5a..3c5a8f699450d71087ffc4c53e529a247190afe7 100644
--- a/openmax/component/video/enc/h264/Exynos_OMX_H264enc.c
+++ b/openmax/component/video/enc/h264/Exynos_OMX_H264enc.c
@@ -3763,11 +3763,28 @@ OMX_ERRORTYPE Exynos_H264Enc_DstOut(
             }
         }
 
-        /* In case of Video buffer batch mode, use timestamp from MFC device driver */
-        if (pVideoBuffer->timestamp != 0)
+        /*
+         * MFC v8 does not provide the capture-buffer timestamp contract used
+         * by newer MFC batch modes.  Its non-zero DQBUF timestamp may be from
+         * an unrelated clock and must not replace the timestamp paired with
+         * this encoded frame through the hardware frame tag.
+         */
+        if (pH264Enc->hMFCH264Handle.videoInstInfo.HwVersion == MFC_80) {
+            if (pExynosComponent->bTimestampSlotUsed[indexTimestamp] != OMX_TRUE) {
+                Exynos_OSAL_Log(EXYNOS_LOG_ERROR,
+                                "[%p][%s] MFC v8 frame tag(%d) has no pending timestamp slot",
+                                pExynosComponent, __FUNCTION__, indexTimestamp);
+                ret = (OMX_ERRORTYPE)OMX_ErrorCodecEncode;
+                goto EXIT;
+            }
+
+            pDstOutputData->timeStamp = pExynosComponent->timeStamp[indexTimestamp];
+        } else if (pVideoBuffer->timestamp != 0) {
+            /* In video-buffer batch mode, use the timestamp from the driver. */
             pDstOutputData->timeStamp = pVideoBuffer->timestamp;
-        else
+        } else {
             pDstOutputData->timeStamp = pExynosComponent->timeStamp[indexTimestamp];
+        }
 
         pExynosComponent->bTimestampSlotUsed[indexTimestamp]    = OMX_FALSE;
         pDstOutputData->nFlags                                  = pExynosComponent->nFlags[indexTimestamp];
