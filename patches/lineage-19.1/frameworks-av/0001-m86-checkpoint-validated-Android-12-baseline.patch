+            const status_t requestedStatus = status;
+            const String8 rollback = String8::format("hifi_state=off;%s=%u",
+                    AudioParameter::keySamplingRate, mM86NormalSampleRate);
+            status_t rollbackStatus = mOutput->stream->setParameters(rollback);
+            if (!mStandby && rollbackStatus == INVALID_OPERATION) {
+                mOutput->standby();
+                if (!mStandby) {
+                    mThreadMetrics.logEndInterval();
+                    mStandby = true;
+                }
+                mBytesWritten = 0;
+                rollbackStatus = mOutput->stream->setParameters(rollback);
+            }
+            ALOGE("m86 HiFi route failed: rate=%u status=%d rollback=%d",
+                  m86DesiredRate, requestedStatus, rollbackStatus);
+            if (rollbackStatus == NO_ERROR) {
+                status = NO_ERROR;
+                m86DesiredActive = false;
+                m86DesiredRate = mM86NormalSampleRate;
+            }
         }
         if (status == NO_ERROR && reconfig) {
