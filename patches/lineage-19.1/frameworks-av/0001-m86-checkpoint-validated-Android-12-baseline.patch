             delete mAudioMixer;
             mAudioMixer = new AudioMixer(mNormalFrameCount, mSampleRate);
             for (const auto &track : mTracks) {
@@ -5973,11 +6102,29 @@ bool AudioFlinger::MixerThread::checkForNewParameter_l(const String8& keyValuePa
             }
             sendIoConfigEvent_l(AUDIO_OUTPUT_CONFIG_CHANGED);
         }
+        if (m86HifiRequest && status == NO_ERROR) {
+            mM86HifiRouteActive = m86DesiredActive;
+            mM86HifiRouteRate = m86DesiredActive ? m86DesiredRate : 0;
