+    bool m86DesiredActive = false;
+    uint32_t m86DesiredRate = mM86NormalSampleRate;
+    int m86Recompute;
+    if (param.getInt(String8("m86_hifi_recompute"), m86Recompute) == NO_ERROR) {
+        m86HifiRequest = true;
+        m86ForceReopen = m86Recompute > 1 || mM86HifiForceReopenQueued;
+        mM86HifiRecomputeQueued = false;
+        mM86HifiForceReopenQueued = false;
+
+        const bool userEnabled = property_get_bool(
+                "persist.vendor.m86.hifi.enabled", false);
+        const DeviceTypeSet devices = outDeviceTypes();
+        const bool wired = devices.count(AUDIO_DEVICE_OUT_WIRED_HEADSET) != 0
+                || devices.count(AUDIO_DEVICE_OUT_WIRED_HEADPHONE) != 0;
+        uint32_t commonRate = 0;
+        bool compatible = userEnabled && wired;
+        for (const sp<Track>& track : mActiveTracks) {
+            if (track->streamType() == AUDIO_STREAM_SYSTEM) {
+                continue;
+            }
+            const uint32_t rate = track->sampleRate();
+            const bool supportedRate = rate == 44100 || rate == 48000
+                    || rate == 88200 || rate == 96000
+                    || rate == 176400 || rate == 192000;
+            const bool media = track->attributes().usage == AUDIO_USAGE_MEDIA
+                    || track->streamType() == AUDIO_STREAM_MUSIC;
+            if (!media || !audio_is_linear_pcm(track->format())
+                    || audio_channel_count_from_out_mask(track->channelMask()) != 2
+                    || !supportedRate || (commonRate != 0 && commonRate != rate)) {
+                compatible = false;
+                break;
+            }
+            commonRate = rate;
+        }
+        m86DesiredActive = compatible && commonRate != 0;
+        m86DesiredRate = m86DesiredActive ? commonRate : mM86NormalSampleRate;
+        outputParameters = String8::format("hifi_state=%s;%s=%u",
+                m86DesiredActive ? "on" : "off",
+                AudioParameter::keySamplingRate, m86DesiredRate);
+        param = AudioParameter(outputParameters);
+        ALOGI("m86 HiFi arbitration: user=%d wired=%d active=%d rate=%u tracks=%zu",
+              userEnabled ? 1 : 0, wired ? 1 : 0, m86DesiredActive ? 1 : 0,
+              m86DesiredRate, mActiveTracks.size());
+        if (!m86ForceReopen && m86DesiredActive == mM86HifiRouteActive
+                && mSampleRate == m86DesiredRate) {
+            return false;
+        }
+    }
     int value;
     if (param.getInt(String8(AudioParameter::keySamplingRate), value) == NO_ERROR) {
         reconfig = true;
