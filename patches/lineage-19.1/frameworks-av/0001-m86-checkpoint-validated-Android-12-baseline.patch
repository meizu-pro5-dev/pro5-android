+// Queue a parameter update without waiting. Callers already running on the
+// playback thread must not wait for processConfigEvents_l() on that same thread.
+void AudioFlinger::ThreadBase::sendSetParameterConfigEventAsync_l(
+        const String8& keyValuePair)
+{
+    sp<ConfigEvent> configEvent = new SetParameterConfigEvent(keyValuePair);
+    configEvent->mWaitStatus = false;
+    mConfigEvents.add(configEvent);
+    mWaitWorkCV.signal();
+}
