+void AudioFlinger::MixerThread::requestM86HifiRecompute_l(bool forceReopen)
+{
+    if (mType != MIXER) {
+        return;
+    }
+    mM86HifiForceReopenQueued |= forceReopen;
+    if (mM86HifiRecomputeQueued) {
+        return;
+    }
+    mM86HifiRecomputeQueued = true;
+    sendSetParameterConfigEventAsync_l(String8::format(
+            "m86_hifi_recompute=%d", forceReopen ? 2 : 1));
+}
