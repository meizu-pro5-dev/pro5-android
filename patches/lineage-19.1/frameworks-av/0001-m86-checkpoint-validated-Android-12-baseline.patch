 #include <android/hidl/manager/1.0/IServiceManager.h>
 #include <hwbinder/IPCThreadState.h>
+#include <cutils/properties.h>
 #include <media/AudioParameter.h>
 #include <mediautils/SchedulingPolicyService.h>
 #include <utils/Log.h>
@@ -413,6 +414,18 @@ status_t StreamOutHalHidl::write(const void *buffer, size_t bytes, size_t *writt
         if ((status = getCachedBufferSize(&bufferSize)) != OK) {
             return status;
         }
+        // The Flyme m86 primary HAL changes its output buffer from 4 KiB at
+        // 44.1 kHz up to 16 KiB at 176.4/192 kHz without reopening the
+        // stream. HIDL permits prepareForWriting() only once, so a queue
+        // created by an earlier system sound would otherwise remain 4 KiB
+        // and truncate every later high-rate write. Reserve the largest
+        // Flyme write block in the transport queue; this does not alter the
+        // HAL/ALSA buffer size or AudioFlinger latency.
+        constexpr size_t kM86MaxHifiWriteSize = 16 * 1024;
+        if (property_get_bool("ro.meizu.hardware.hifi", false)
+                && bufferSize < kM86MaxHifiWriteSize) {
+            bufferSize = kM86MaxHifiWriteSize;
+        }
         if (bytes > bufferSize) bufferSize = bytes;
         if ((status = prepareForWriting(bufferSize)) != OK) {
             return status;
