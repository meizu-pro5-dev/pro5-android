From 3ed4442e4c19373a9dc39f157e793994d1a9f5ef Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Sun, 9 Aug 2026 14:00:00 +0800
Subject: [PATCH] audioflinger: route Meizu HiFi state to primary output

The stock m86 audio HAL implements hifi_state in the output stream
set_parameters callback, not in the device callback. Android's parameter API
uses AUDIO_IO_HANDLE_NONE for framework calls and therefore only invokes the
device callback, leaving the ES9018 path unreachable.

Forward this vendor key to the primary playback thread. Keep hifi_gain on the
normal global path because the HAL handles it at device scope.
---
 services/audioflinger/AudioFlinger.cpp | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/services/audioflinger/AudioFlinger.cpp b/services/audioflinger/AudioFlinger.cpp
index 7fc14d7e2..b9f3a4cb1 100644
--- a/services/audioflinger/AudioFlinger.cpp
+++ b/services/audioflinger/AudioFlinger.cpp
@@ -1461,6 +1461,25 @@ status_t AudioFlinger::setParameters(audio_io_handle_t ioHandle, const String8&
 
     ALOGV("%s: filtered keyvalue %s", __func__, filteredKeyValuePairs.string());
 
+    // The m86 stock HAL consumes hifi_state in out_set_parameters(), while
+    // framework callers use AUDIO_IO_HANDLE_NONE. Route only that legacy key
+    // to the primary output; hifi_gain is intentionally device-scoped.
+    if (ioHandle == AUDIO_IO_HANDLE_NONE) {
+        AudioParameter meizuParameters(filteredKeyValuePairs);
+        String8 hifiState;
+        if (meizuParameters.get(String8("hifi_state"), hifiState) == NO_ERROR) {
+            sp<PlaybackThread> thread;
+            {
+                Mutex::Autolock _l(mLock);
+                thread = primaryPlaybackThread_l();
+            }
+            if (thread != nullptr) {
+                return thread->setParameters(filteredKeyValuePairs);
+            }
+            ALOGW("setParameters(): no primary playback thread for hifi_state");
+        }
+    }
+
     // AUDIO_IO_HANDLE_NONE means the parameters are global to the audio hardware interface
     if (ioHandle == AUDIO_IO_HANDLE_NONE) {
         Mutex::Autolock _l(mLock);
