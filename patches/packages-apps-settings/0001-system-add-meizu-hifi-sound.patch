+package com.android.settings.system;
+
+import android.content.Context;
+import android.os.SystemProperties;
+
+import com.android.settings.core.BasePreferenceController;
+
+/** Shows the HiFi entry only on products that expose the Meizu audio protocol. */
+public class HifiSoundPreferenceController extends BasePreferenceController {
+
+    private static final String PROPERTY_HIFI_SUPPORTED = "ro.hardware.hifi.support";
+
+    public HifiSoundPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return SystemProperties.getBoolean(PROPERTY_HIFI_SUPPORTED, false)
+                ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+}
diff --git a/src/com/android/settings/system/HifiSoundSettings.java b/src/com/android/settings/system/HifiSoundSettings.java
new file mode 100644
index 000000000..83fb5d976
--- /dev/null
+++ b/src/com/android/settings/system/HifiSoundSettings.java
@@ -0,0 +1,121 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.system;
+
+import android.app.settings.SettingsEnums;
+import android.content.Context;
+import android.media.AudioManager;
+import android.os.Bundle;
+import android.provider.SearchIndexableResource;
+import android.provider.Settings;
+
+import androidx.appcompat.app.AlertDialog;
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.SwitchPreference;
+
+import com.android.settings.R;
+import com.android.settings.SettingsPreferenceFragment;
+import com.android.settings.search.BaseSearchIndexProvider;
+import com.android.settings.search.Indexable;
+import com.android.settingslib.search.SearchIndexable;
+
+import java.util.Arrays;
+import java.util.List;
+
+@SearchIndexable
+public class HifiSoundSettings extends SettingsPreferenceFragment
+        implements Preference.OnPreferenceChangeListener {
+
+    private static final String KEY_HIFI_ENABLED = "hifi_music_enabled";
+    private static final String KEY_HIFI_GAIN = "hifi_music_param";
+    private static final int GAIN_AUTO = 0;
+    private static final int GAIN_HIGH = 2;
+    private static final int GAIN_LINE_OUT = 3;
+
+    private SwitchPreference mEnabled;
+    private ListPreference mGain;
+    private AudioManager mAudioManager;
+
+    @Override
+    public void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        addPreferencesFromResource(R.xml.hifi_sound_settings);
+
+        mAudioManager = getContext().getSystemService(AudioManager.class);
+        mEnabled = findPreference(KEY_HIFI_ENABLED);
+        mGain = findPreference(KEY_HIFI_GAIN);
+        mEnabled.setOnPreferenceChangeListener(this);
+        mGain.setOnPreferenceChangeListener(this);
+        refreshState();
+    }
+
+    private void refreshState() {
+        final boolean enabled = Settings.System.getInt(getContentResolver(),
+                KEY_HIFI_ENABLED, 1) != 0;
+        final int gain = Settings.System.getInt(getContentResolver(), KEY_HIFI_GAIN, GAIN_AUTO);
+        mEnabled.setChecked(enabled);
+        mGain.setEnabled(enabled);
+        mGain.setValue(Integer.toString(Math.max(GAIN_AUTO, Math.min(GAIN_LINE_OUT, gain))));
+        mGain.setSummary(mGain.getEntry());
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        if (preference == mEnabled) {
+            final boolean enabled = (Boolean) newValue;
+            Settings.System.putInt(getContentResolver(), KEY_HIFI_ENABLED, enabled ? 1 : 0);
+            mGain.setEnabled(enabled);
+            return true;
+        }
+
+        if (preference == mGain) {
+            final int gain = Integer.parseInt((String) newValue);
+            if (gain == GAIN_LINE_OUT) {
+                new AlertDialog.Builder(getContext())
+                        .setTitle(R.string.hifi_line_out_warning_title)
+                        .setMessage(R.string.hifi_line_out_warning_message)
+                        .setNegativeButton(android.R.string.cancel, null)
+                        .setPositiveButton(android.R.string.ok,
+                                (dialog, which) -> applyGain(GAIN_LINE_OUT))
+                        .show();
+                return false;
+            }
+            applyGain(gain);
+            return true;
+        }
+        return false;
+    }
+
+    private void applyGain(int gain) {
+        if (gain >= GAIN_HIGH && mAudioManager != null) {
+            final int current = mAudioManager.getStreamVolume(AudioManager.STREAM_MUSIC);
+            final int safeHighGain = Math.max(1,
+                    mAudioManager.getStreamMaxVolume(AudioManager.STREAM_MUSIC) * 4 / 5);
+            if (current > safeHighGain) {
+                mAudioManager.setStreamVolume(AudioManager.STREAM_MUSIC, safeHighGain, 0);
+            }
+        }
+        Settings.System.putInt(getContentResolver(), KEY_HIFI_GAIN, gain);
+        mGain.setValue(Integer.toString(gain));
+        mGain.setSummary(mGain.getEntry());
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.SETTINGS_SYSTEM_CATEGORY;
+    }
+
+    public static final Indexable.SearchIndexProvider SEARCH_INDEX_DATA_PROVIDER =
+            new BaseSearchIndexProvider() {
+                @Override
+                public List<SearchIndexableResource> getXmlResourcesToIndex(
+                        Context context, boolean enabled) {
+                    final SearchIndexableResource sir = new SearchIndexableResource(context);
+                    sir.xmlResId = R.xml.hifi_sound_settings;
+                    return Arrays.asList(sir);
+                }
+            };
+}
