From 6b20f175d4ba5e720b56d4196bcb435679f731bd Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Sun, 9 Aug 2026 14:05:00 +0800
Subject: [PATCH] audio: restore Meizu HiFi routing

Drive the legacy m86 hifi_state and hifi_gain parameters from persistent
Android settings. Apply HiFi only while media is routed to a wired headset,
and restore the state after route changes and audioserver restarts.
---
 .../com/android/server/audio/AudioService.java     | 77 ++++++++++++++++++++++
 1 file changed, 77 insertions(+)

diff --git a/services/core/java/com/android/server/audio/AudioService.java b/services/core/java/com/android/server/audio/AudioService.java
index 2a4e229fcdd..62a05f27be0 100644
--- a/services/core/java/com/android/server/audio/AudioService.java
+++ b/services/core/java/com/android/server/audio/AudioService.java
@@ -278,6 +278,7 @@ public class AudioService extends IAudioService.Stub {
     private static final int MSG_OBSERVE_DEVICES_FOR_ALL_STREAMS = 27;
     private static final int MSG_HDMI_VOLUME_CHECK = 28;
     private static final int MSG_PLAYBACK_CONFIG_CHANGE = 29;
+    private static final int MSG_APPLY_MEIZU_HIFI = 30;
     // start of messages handled under wakelock
     //   these messages can only be queued, i.e. sent with queueMsgUnderWakeLock(),
     //   and not with sendMsg(..., ..., SENDMSG_QUEUE, ...)
@@ -300,6 +301,16 @@ public class AudioService extends IAudioService.Stub {
 
     private SettingsObserver mSettingsObserver;
 
+    private static final String MEIZU_HIFI_ENABLED = "hifi_music_enabled";
+    private static final String MEIZU_HIFI_GAIN = "hifi_music_param";
+    private static final int MEIZU_HIFI_GAIN_AUTO = 0;
+    private static final int MEIZU_HIFI_GAIN_LINE_OUT = 3;
+    private static final boolean SUPPORTS_MEIZU_HIFI = SystemProperties.getBoolean(
+            "ro.hardware.hifi.support", false);
+
+    private int mMeizuHifiAppliedState = -1;
+    private int mMeizuHifiAppliedGain = -1;
+
     private int mMode = AudioSystem.MODE_NORMAL;
     // protects mRingerMode
     private final Object mSettingsLock = new Object();
@@ -887,5 +898,6 @@ public class AudioService extends IAudioService.Stub {
 
         mDeviceBroker.onSystemReady();
+        postApplyMeizuHifiState(1000);
 
         if (mContext.getPackageManager().hasSystemFeature(PackageManager.FEATURE_HDMI_CEC)) {
             synchronized (mHdmiClientLock) {
@@ -998,6 +1010,9 @@ public class AudioService extends IAudioService.Stub {
         // Restore device connection states, BT state
         mDeviceBroker.onAudioServerDied();
 
+        mMeizuHifiAppliedState = -1;
+        mMeizuHifiAppliedGain = -1;
+        postApplyMeizuHifiState(1000);
         // Restore call state
         if (AudioSystem.setPhoneState(mMode) ==  AudioSystem.AUDIO_STATUS_OK) {
             mModeLogger.log(new AudioEventLogger.StringEvent(
@@ -4488,8 +4503,60 @@ public class AudioService extends IAudioService.Stub {
     }
 
     private void onObserveDevicesForAllStreams() {
         observeDevicesForStreams(-1);
+        onApplyMeizuHifiState();
     }
 
+    private void postApplyMeizuHifiState(int delayMs) {
+        if (!SUPPORTS_MEIZU_HIFI) {
+            return;
+        }
+        sendMsg(mAudioHandler, MSG_APPLY_MEIZU_HIFI, SENDMSG_REPLACE,
+                0, 0, null, delayMs);
+    }
+
+    private void onApplyMeizuHifiState() {
+        if (!SUPPORTS_MEIZU_HIFI) {
+            return;
+        }
+
+        final int devices = AudioSystem.getDevicesForStream(AudioSystem.STREAM_MUSIC);
+        final int wiredDevices = AudioSystem.DEVICE_OUT_WIRED_HEADSET
+                | AudioSystem.DEVICE_OUT_WIRED_HEADPHONE;
+        final boolean wired = (devices & wiredDevices) != 0;
+        final boolean enabled = Settings.System.getIntForUser(mContentResolver,
+                MEIZU_HIFI_ENABLED, 1, UserHandle.USER_CURRENT) != 0;
+        final int requestedGain = Settings.System.getIntForUser(mContentResolver,
+                MEIZU_HIFI_GAIN, MEIZU_HIFI_GAIN_AUTO, UserHandle.USER_CURRENT);
+        final int gain = Math.max(MEIZU_HIFI_GAIN_AUTO,
+                Math.min(MEIZU_HIFI_GAIN_LINE_OUT, requestedGain));
+        final int state = enabled && wired ? 1 : 0;
+
+        if (state != mMeizuHifiAppliedState) {
+            final int status = AudioSystem.setParameters(
+                    state == 1 ? "hifi_state=on" : "hifi_state=off");
+            if (status != AudioSystem.AUDIO_STATUS_OK) {
+                Log.w(TAG, "Unable to apply Meizu HiFi state " + state
+                        + ", status=" + status);
+                return;
+            }
+            mMeizuHifiAppliedState = state;
+            mMeizuHifiAppliedGain = -1;
+            Log.i(TAG, "Meizu HiFi " + (state == 1 ? "enabled" : "disabled")
+                    + " for media devices 0x" + Integer.toHexString(devices));
+        }
+
+        if (state == 1 && gain != mMeizuHifiAppliedGain) {
+            final int status = AudioSystem.setParameters("hifi_gain=" + gain);
+            if (status == AudioSystem.AUDIO_STATUS_OK) {
+                mMeizuHifiAppliedGain = gain;
+                Log.i(TAG, "Meizu HiFi gain=" + gain);
+            } else {
+                Log.w(TAG, "Unable to apply Meizu HiFi gain " + gain
+                        + ", status=" + status);
+            }
+        }
+    }
+
     /*package*/ static final int CONNECTION_STATE_DISCONNECTED = 0;
     /*package*/ static final int CONNECTION_STATE_CONNECTED = 1;
@@ -5648,7 +5715,11 @@ public class AudioService extends IAudioService.Stub {
 
                 case MSG_OBSERVE_DEVICES_FOR_ALL_STREAMS:
                     onObserveDevicesForAllStreams();
                     break;
+
+                case MSG_APPLY_MEIZU_HIFI:
+                    onApplyMeizuHifiState();
+                    break;
 
                 case MSG_HDMI_VOLUME_CHECK:
                     onCheckVolumeCecOnHdmiConnection(msg.arg1, (String) msg.obj);
@@ -5681,6 +5752,11 @@ public class AudioService extends IAudioService.Stub {
             mContentResolver.registerContentObserver(Settings.Secure.getUriFor(
                     Settings.Secure.VOLUME_LINK_NOTIFICATION), false, this);
 
+            mContentResolver.registerContentObserver(Settings.System.getUriFor(
+                    MEIZU_HIFI_ENABLED), false, this);
+            mContentResolver.registerContentObserver(Settings.System.getUriFor(
+                    MEIZU_HIFI_GAIN), false, this);
+
             mEncodedSurroundMode = Settings.Global.getInt(
                     mContentResolver, Settings.Global.ENCODED_SURROUND_OUTPUT,
                     Settings.Global.ENCODED_SURROUND_OUTPUT_AUTO);
@@ -5732,5 +5808,6 @@ public class AudioService extends IAudioService.Stub {
                 updateAssistantUId(false);
                 updateRttEanbled(mContentResolver);
+                postApplyMeizuHifiState(0);
 
                 boolean linkNotificationWithVolume = Settings.Secure.getInt(mContentResolver,
                         Settings.Secure.VOLUME_LINK_NOTIFICATION, 1) == 1;
-- 
2.39.5
