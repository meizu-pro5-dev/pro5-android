--- a/init.rc
+++ b/init.rc
@@ -45,13 +45,17 @@
     mkdir /dev/usb-ffs 0770 shell shell
     mkdir /dev/usb-ffs/adb 0770 shell shell
 
+    # Test-only: make TWRP skip MTP before recovery starts. The legacy static
+    # adbd remains available for collecting /tmp/recovery.log.
+    setprop mtp.crash_check 1
+
     write /sys/module/decon/parameters/decon_log_level 7
 
     stop adbd
     write /sys/class/android_usb/android0/enable 0
     write /sys/class/android_usb/android0/idVendor 18D1
-    write /sys/class/android_usb/android0/idProduct 4EE2
-    write /sys/class/android_usb/android0/functions mtp,adb
+    write /sys/class/android_usb/android0/idProduct 4EE7
+    write /sys/class/android_usb/android0/functions adb
     write /sys/class/android_usb/android0/iManufacturer MEIZU
     write /sys/class/android_usb/android0/iProduct MEIZU_Android
     write /sys/class/android_usb/android0/iSerial ${ro.serialno}
@@ -63,6 +67,9 @@
     hostname localhost
     domainname localdomain
 
+    # Re-assert ADB after the imported device rc's legacy MTP product ID.
+    setprop sys.usb.config adb
+
     class_start default
 
 # Load properties, pre-Android 6.0
@@ -88,9 +95,14 @@
     trigger early-boot
     trigger boot
 
-on property:sys.powerctl=*
-   powerctl ${sys.powerctl}
+# Test-only: ignore a normal system reboot so the tmpfs recovery log survives.
+# Explicit bootloader/recovery requests remain usable as escape paths.
+on property:sys.powerctl=reboot,bootloader
+    powerctl ${sys.powerctl}
 
+on property:sys.powerctl=reboot,recovery
+    powerctl ${sys.powerctl}
+
 on property:sys.usb.config=none
     stop adbd
     write /sys/class/android_usb/android0/enable 0
@@ -99,15 +111,17 @@
 on property:sys.usb.config=mtp,adb
     stop adbd
     write /sys/class/android_usb/android0/enable 0
-    write /sys/class/android_usb/android0/functions mtp,adb
+    write /sys/class/android_usb/android0/idProduct 4EE7
+    write /sys/class/android_usb/android0/functions adb
     write /sys/class/android_usb/android0/enable 1
     start adbd
 
 on property:sys.usb.config=adb
     stop adbd
     write /sys/class/android_usb/android0/enable 0
+    write /sys/class/android_usb/android0/idProduct 4EE7
     write /sys/class/android_usb/android0/functions adb
-    write /sys/class/android_usb/android0/enable ${service.adb.root}
+    write /sys/class/android_usb/android0/enable 1
     start adbd
 
 service ueventd /sbin/ueventd
@@ -119,6 +133,7 @@
 #    seclabel u:r:healthd:s0
 
 service recovery /sbin/recovery
+    oneshot
 
 service adbd /sbin/adbd
     disabled
@@ -134,5 +149,7 @@
 # Restart adbd so it can run as root
 on property:service.adb.root=1
     write /sys/class/android_usb/android0/enable 0
+    write /sys/class/android_usb/android0/idProduct 4EE7
+    write /sys/class/android_usb/android0/functions adb
     restart adbd
     write /sys/class/android_usb/android0/enable 1
