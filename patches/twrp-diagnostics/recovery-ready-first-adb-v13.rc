# Test-only PRO 5 TWRP v13 init.
#
# The old minadbd uses /dev/android_adb. Start it while the gadget is disabled;
# the synchronous recovery wrapper waits for the kernel's adb_open marker before
# publishing the native ADB function. This matches the f_adb ready-first
# contract and avoids relying on the enable-before-open disable-depth handoff.

on early-init
    setenforce permissive

    write /sys/fs/selinux/checkreqprot 0
    setcon u:r:init:s0

    start ueventd
    start healthd

service set_permissive /sbin/toolbox setenforce 0
    oneshot
    seclabel u:r:recovery:s0

on init
    export PATH /sbin:/system/bin
    export LD_LIBRARY_PATH .:/sbin
    export ANDROID_ROOT /system
    export ANDROID_DATA /data
    export EXTERNAL_STORAGE /sdcard

    mkdir /boot
    mkdir /recovery
    mkdir /system
    mkdir /data
    mkdir /cache
    mkdir /custom
    mkdir /efs
    mkdir /sideload
    mkdir /storage
    mkdir /storage/sdcard1
    mount tmpfs tmpfs /tmp

    chown root shell /tmp
    chmod 0775 /tmp

    write /proc/sys/kernel/panic_on_oops 1

on fs
    mount pstore pstore /sys/fs/pstore

    setprop mtp.crash_check 1
    write /sys/module/decon/parameters/decon_log_level 7

    stop adbd
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/bDeviceClass 0
    write /sys/class/android_usb/android0/bDeviceSubClass 0
    write /sys/class/android_usb/android0/bDeviceProtocol 0

on boot
    ifup lo
    hostname localhost
    domainname localdomain

    write /dev/kmsg pro5_twrp_v13_usb_ready_first_begin
    stop adbd
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 2A45
    write /sys/class/android_usb/android0/idProduct 0C01
    write /sys/class/android_usb/android0/iManufacturer Meizu
    write /sys/class/android_usb/android0/iProduct PRO5_TWRP_V13
    write /sys/class/android_usb/android0/iSerial PRO5TWRPV13
    write /sys/class/android_usb/android0/bDeviceClass 0
    write /sys/class/android_usb/android0/bDeviceSubClass 0
    write /sys/class/android_usb/android0/bDeviceProtocol 0
    start adbd
    setprop sys.usb.config adb
    write /dev/kmsg pro5_twrp_v13_adbd_started_gadget_disabled

    class_start default

# Load properties, pre-Android 6.0.
on load_all_props_action
    load_all_props

on firmware_mounts_complete
    rm /dev/.booting

on late-init
    trigger early-fs
    trigger fs
    trigger post-fs
    trigger post-fs-data

    trigger load_all_props_action
    trigger firmware_mounts_complete

    trigger early-boot
    trigger boot

# The recovery ELF writes its ordinary GUI-return request to twrp.loghold.
# Explicit bootloader/recovery power requests remain available as escapes.
on property:sys.powerctl=reboot,bootloader
    powerctl ${sys.powerctl}

on property:sys.powerctl=reboot,recovery
    powerctl ${sys.powerctl}

service ueventd /sbin/ueventd
    critical
#    seclabel u:r:ueventd:s0

service healthd /sbin/healthd -r
    critical
#    seclabel u:r:healthd:s0

service recovery /sbin/sh /sbin/permissive.sh
    oneshot
    seclabel u:r:recovery:s0

service adbd /sbin/adbd
    disabled
    socket adbd stream 660 system system
#    seclabel u:r:adbd:s0
