on init
    mkdir /custom 0555 root root
    mkdir /efs 0555 root root
    mkdir /mnv 0555 root root
    mkdir /external_sd 0770 root root
    mkdir /usb-otg 0770 root root
    # Android 9 adbd and TWRP MTP otherwise attempt FunctionFS AIO, which the
    # maintained 3.10 kernel does not provide. Both userspaces retain a
    # synchronous-I/O and v1-descriptor compatibility path.
    setprop sys.usb.ffs.aio_compat 1

on fs
    # Keep TWRP's upstream FunctionFS mount and USB property state machine.
    # Flyme on this handset currently enumerates its working ADB-only gadget as
    # 18d1:4ee7. Do not advertise the MTP+ADB PID while only ADB is selected.
    write /sys/class/android_usb/android0/idVendor 18D1
    write /sys/class/android_usb/android0/idProduct 4EE7
    write /sys/class/android_usb/android0/iManufacturer MEIZU
    write /sys/class/android_usb/android0/iProduct "PRO 5 TWRP"
    write /sys/class/android_usb/android0/iSerial ${ro.serialno}

on post-fs
    # The upstream fs action has now mounted /dev/usb-ffs/adb and selected the
    # f_ffs alias. Force one ordered ADB-only transition before recovery starts;
    # TWRP may later switch to 18d1:4ee2 when it enables MTP.
    setprop service.adb.root 1
    setprop sys.usb.config none
    setprop sys.usb.config adb
